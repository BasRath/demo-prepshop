{
  "name": "demo-prepshop",
  "version": "1.0.0",
  "private": true,
  "description": "Prep Shop – a static demo webshop. Dev dependencies are used for end-to-end testing only; the site itself has no runtime dependencies.",
  "type": "module",
  "scripts": {
    "serve": "node tests/support/static-server.mjs",
    "test:e2e": "bddgen && playwright test",
    "test:e2e:ticket": "bddgen && playwright test --grep",
    "ticket:fetch": "node .github/skills/refine-ticket/scripts/fetch-ticket.mjs",
    "report": "node .github/skills/test-report/scripts/generate-report.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BasRath/demo-prepshop.git"
  },
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "playwright-bdd": "^9.2.1"
  }
}
